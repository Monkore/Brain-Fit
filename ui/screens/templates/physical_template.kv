#:kivy 2.3.0

<PhysicalTemplateScreen>:
    MDBoxLayout:
        orientation: "vertical"
        padding: "24dp"
        spacing: "24dp"

        MDLabel:
            text: root.activity_name
            font_style: "H4"
            halign: "center"
            size_hint_y: 0.1

        MDLabel:
            text: root.activity_description
            font_style: "Body1"
            halign: "center"
            size_hint_y: 0.2
            
        MDFloatLayout:
            size_hint_y: 0.5
            MDLabel:
                text: "Camera / Tracking View"
                halign: "center"
                valign: "center"
                # This would normally be replaced by a Camera widget for MediaPipe

        MDLabel:
            text: root.feedback_text
            font_style: "H5"
            halign: "center"
            theme_text_color: "Custom"
            text_color: app.theme_cls.primary_color
            size_hint_y: 0.1

        MDLabel:
            text: f"Time Remaining: {root.time_left}s"
            font_style: "H3"
            halign: "center"
            size_hint_y: 0.1
